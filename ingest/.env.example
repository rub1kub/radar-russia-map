# Скопируйте этот файл в ingest/.env и заполните своими значениями.
# ingest/.env в git не попадает — он в .gitignore.

# Получить на https://my.telegram.org/apps (раздел API development tools).
TG_API_ID=
TG_API_HASH=

# Имя файла сессии в ingest/data/sessions/.
TG_SESSION_NAME=radar

# Необязательно: переопределить список источников.
# Формат: key:username:label через запятую.
# TG_SOURCES=locatorru:locatorru:Локатор России,vrv_radar:radar_vrv:Радар ВРВ
